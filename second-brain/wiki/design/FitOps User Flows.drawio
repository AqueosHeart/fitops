        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#111310;" value="CANCELLATION AND FIFO PROMOTION" vertex="1">
          <mxGeometry x="40" y="25" width="1300" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5C6159;" value="Cutoff enforcement, transactional promotion, and audit trail without capacity drift" vertex="1">
          <mxGeometry x="40" y="60" width="1300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="start" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F0E8;strokeColor=#111310;fontColor=#111310;fontSize=13;spacing=8;" value="Member opens My bookings" vertex="1">
          <mxGeometry x="650" y="90" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="select" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F0E8;strokeColor=#111310;fontColor=#111310;fontSize=13;spacing=8;" value="Select confirmed reservation" vertex="1">
          <mxGeometry x="650" y="200" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cutoffDisplay" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#7A4B00;fontColor=#111310;fontSize=12;spacing=8;" value="Before configured cancellation cutoff?" vertex="1">
          <mxGeometry x="650" y="310" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="locked" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7DFDC;strokeColor=#9E2E25;fontColor=#111310;fontSize=13;spacing=8;" value="Cancellation unavailable&lt;br&gt;Cutoff passed; reservation retained" vertex="1">
          <mxGeometry x="1020" y="310" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dialog" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F0E8;strokeColor=#111310;fontColor=#111310;fontSize=13;spacing=8;" value="Confirm cancellation&lt;br&gt;Explain possible waitlist promotion" vertex="1">
          <mxGeometry x="650" y="420" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="choice" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#7A4B00;fontColor=#111310;fontSize=12;spacing=8;" value="Member choice" vertex="1">
          <mxGeometry x="650" y="530" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="retain" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;fontColor=#111310;fontSize=12;spacing=8;" value="Close dialog; reservation retained" vertex="1">
          <mxGeometry x="200" y="660" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="submit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F0E8;strokeColor=#111310;fontColor=#111310;fontSize=13;spacing=8;" value="Submit cancellation request" vertex="1">
          <mxGeometry x="650" y="660" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="secNoteCancel" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;fontColor=#111310;fontSize=12;spacing=8;" value="Security &amp; policy guard:&lt;br&gt;CSRF token verified, rate limit enforced, cutoff verified on server" vertex="1">
          <mxGeometry x="200" y="770" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="validate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F0E8;strokeColor=#111310;fontColor=#111310;fontSize=13;spacing=8;" value="Server verifies session identity, ownership, CSRF token, rate limit, confirmed status, and cutoff" vertex="1">
          <mxGeometry x="650" y="770" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="valid" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#7A4B00;fontColor=#111310;fontSize=12;spacing=8;" value="Still eligible to cancel?" vertex="1">
          <mxGeometry x="650" y="880" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rejected" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7DFDC;strokeColor=#9E2E25;fontColor=#111310;fontSize=13;spacing=8;" value="Show stable domain error&lt;br&gt;Refresh current booking state" vertex="1">
          <mxGeometry x="1020" y="880" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="transaction" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F0E8;strokeColor=#111310;fontColor=#111310;fontSize=13;spacing=8;" value="Begin one database transaction" vertex="1">
          <mxGeometry x="650" y="990" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rollback" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7DFDC;strokeColor=#9E2E25;fontColor=#111310;fontSize=13;spacing=8;" value="Roll back all changes&lt;br&gt;Reservation remains confirmed" vertex="1">
          <mxGeometry x="1020" y="990" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cancelBooking" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F0E8;strokeColor=#111310;fontColor=#111310;fontSize=13;spacing=8;" value="Mark booking cancelled" vertex="1">
          <mxGeometry x="650" y="1100" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nextEntry" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F0E8;strokeColor=#111310;fontColor=#111310;fontSize=13;spacing=8;" value="Select earliest FIFO waiting entry" vertex="1">
