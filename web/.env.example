# Local Docker Compose PostgreSQL (port 5433). Change only for your local setup.
DATABASE_URL=postgresql://fitops:replace_with_a_generated_local_password@127.0.0.1:5433/fitops?schema=public
# Generate a unique 32-byte-or-longer secret for this computer. Never commit it.
BETTER_AUTH_SECRET=
# The public application origin, for example http://localhost:3000 in development.
BETTER_AUTH_URL=http://localhost:3000
# Optional: set a private 15-128 character password before seeding a fresh local DB.
# All fictional seed users will share it. Leave blank for random, unusable seed credentials.
FITOPS_DEMO_PASSWORD=
