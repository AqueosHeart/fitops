flowchart TD
    classDef error fill:#F7DFDC,stroke:#9E2E25,color:#111310;
    classDef decision fill:#FFF4D6,stroke:#7A4B00,color:#111310;

    Start([User signs in]) --> Role{Trainer role?}
    Role -- No --> Forbidden["Access denied<br/>Do not expose trainer data"]:::error --> Start
    Role -- Yes --> Load[Load assigned upcoming sessions]
    Load --> Result{Request result}
    Result -- Loading --> Loading[Show stable loading skeleton]
    Loading --> Result
    Result -- Failure --> Retry[Show request ID and retry]:::error
    Retry --> Load
    Result -- Empty --> Empty[No assigned upcoming sessions]
    Result -- Ready --> List[Show assigned sessions and attendee counts]
    List --> Select[Select an assigned session]
    Select --> Authorized{Assigned to this trainer?}
    Authorized -- No --> Forbidden --> Start
    Authorized -- Yes --> Detail["Read-only session details and attendee count<br/>No trainer editing in version one"] --> List

    class Role,Result,Authorized decision;
