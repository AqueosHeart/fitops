flowchart TD
    classDef success fill:#DDEBD8,stroke:#1F4D32,color:#111310;
    classDef error fill:#F7DFDC,stroke:#9E2E25,color:#111310;
    classDef decision fill:#FFF4D6,stroke:#7A4B00,color:#111310;

    Start([Member opens My bookings]) --> Load[Load confirmed reservations and waiting entries]
    Load --> Loading[Show stable loading skeleton]
    Loading --> LoadState{Request result}
    LoadState -- Failure --> Retry[Show recoverable error and retry]:::error
    Retry --> Load
    LoadState -- Empty --> Empty[No upcoming bookings or waitlist entries]
    LoadState -- Ready --> Select[Select a waiting entry]
    Select --> Details["Show session details, current FIFO position, and Leave waitlist action"]
    Details --> Choice{Member choice}
    Choice -- Keep waiting --> End([Remain on waitlist])
    Choice -- Leave waitlist --> Submit[Submit removal request]

    Submit --> ServerCheck["Server verifies identity, ownership, and current entry status"]
    ServerCheck --> Status{Current status}
    Status -- Waiting --> Remove[Atomically mark entry cancelled]
    Remove --> Removed["Removed from waitlist<br/>Refresh My bookings"]:::success --> Start
    Status -- Promoted --> Promoted["Entry was already promoted<br/>Show confirmed reservation and cancellation policy"] --> ConfirmedReservation["Open confirmed reservation; cancellation remains available before cutoff"]
    Status -- Cancelled or expired --> Resolved["Entry already resolved<br/>Refresh My bookings"] --> Start
    ServerCheck -. unexpected failure .-> RemoveFailure["Keep entry visible<br/>Show request ID and retry"]:::error
    RemoveFailure -. retry removal .-> Submit

    class LoadState,Choice,Status decision;
